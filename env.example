DB_HOST=
SECRET_KEY=
SENDGRID_API_KEY=
ACCESS_TOKEN=
REFRESH_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SERVER_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000/radio-react

#  ~ News (RSS + LLM)  ----------------------------------------------------------------
# LLM-провайдер: если задан GROQ_API_KEY — используется Groq (бесплатно, высокие лимиты).
# Иначе, если задан GEMINI_API_KEY — Google Gemini. Иначе — fallback (сырой текст).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Как часто забирать RSS-ленты (минуты).
NEWS_FETCH_INTERVAL_MIN=15
# Задержка между вызовами LLM (мс), чтобы не превысить RPM.
NEWS_LLM_DELAY_MS=4500
# Максимум новых items на один прогон источника.
NEWS_MAX_NEW_PER_SOURCE=40
# Сколько items суммаризировать за один вызов LLM (батч, экономит квоту).
NEWS_GEMINI_BATCH=8
# Дневной потолок вызовов LLM (Gemini free ~20/день -> 18 с запасом; Groq -> 400).
NEWS_MAX_LLM_PER_DAY=
# Глубина хранения новостей (дней). 0 — без ограничений. Защищает БД (Mongo 500MB).
NEWS_RETENTION_DAYS=7

